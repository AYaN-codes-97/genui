{
  "name": "genui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node tools/harness/src/check-docs.ts",
    "guard:tamper": "node tools/harness/src/guard-tamper.ts",
    "dev:server": "node apps/server/src/main.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:docs && npm test"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
